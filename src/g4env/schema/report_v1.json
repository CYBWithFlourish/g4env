{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CYBWithFlourish/g4env/schemas/report-1.0.json",
  "title": "g4env security report",
  "description": "Machine readable report produced by `g4env audit`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "risk_score",
    "summary",
    "findings",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "metadata": { "$ref": "#/definitions/metadata" }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "confidence",
        "title",
        "description",
        "evidence",
        "impact",
        "remediation",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 64
        },
        "severity": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/definitions/evidence" }
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "enum": ["rule", "model"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "text", "path"],
      "properties": {
        "line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "path": {
          "type": ["string", "null"],
          "maxLength": 4096
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_version", "provider", "offline"],
      "properties": {
        "tool_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "provider": {
          "type": "string",
          "enum": ["rules", "ollama", "gemini"]
        },
        "offline": {
          "type": "boolean"
        },
        "model": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "network_scope": {
          "type": "string",
          "enum": ["none", "localhost-only", "remote"]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["rules", "ollama", "gemini"]
          }
        }
      }
    }
  }
}
