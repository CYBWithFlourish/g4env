# A configuration file that holds no credentials at all.
# `g4env audit examples/clean.env` must report nothing.
APP_NAME=demo-service
APP_ENV=production
LOG_LEVEL=info
PORT=8080
DEBUG=false
DATABASE_URL=postgres://app_service:${DB_PASSWORD}@db.internal:5432/production
STRIPE_API_KEY=your-api-key-here
TIMEOUT_SECONDS=30
